# ==========================================
# ShopSphere Backend Environment Configuration
# ==========================================
# Copy this file to .env and configure the placeholder values.
# NEVER commit .env to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or local MongoDB instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopsphere?retryWrites=true&w=majority

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:3000

# JSON Web Token Configuration (Minimum 32 random characters for security)
JWT_ACCESS_SECRET=your_jwt_access_token_secret_here_replace_with_strong_random_key
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_here_replace_with_strong_random_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
